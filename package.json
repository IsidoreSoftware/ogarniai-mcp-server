{
  "name": "ogarniai-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for Ogarni.AI personal finance API integration",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ogarniai-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
